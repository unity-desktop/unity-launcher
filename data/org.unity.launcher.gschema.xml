<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.unity.launcher.Position">
    <value nick="left" value="0"/>
    <value nick="right" value="1"/>
    <value nick="bottom" value="2"/>
  </enum>
  <enum id="org.unity.launcher.TileAlignment">
    <value nick="start" value="0"/>
    <value nick="center" value="1"/>
    <value nick="end" value="2"/>
  </enum>
  <enum id="org.unity.launcher.HideMode">
    <value nick="none" value="0"/>
    <value nick="autohide" value="1"/>
    <value nick="intellihide" value="2"/>
  </enum>
  <schema id="org.unity.launcher" path="/org/unity/launcher/">
    <key name="position" enum="org.unity.launcher.Position">
      <default>'left'</default>
      <summary>Screen edge the launcher sits on</summary>
    </key>
    <key name="hide" enum="org.unity.launcher.HideMode">
      <default>'none'</default>
      <summary>When the launcher hides itself in desktop-view</summary>
    </key>
    <key name="tile-alignment" enum="org.unity.launcher.TileAlignment">
      <default>'start'</default>
      <summary>Alignment of the app tiles along the launcher</summary>
    </key>
    <key name="pinned-apps" type="as">
      <default>[]</default>
      <summary>Pinned application .desktop ids, in launcher order</summary>
    </key>
    <key name="launcher-icon-size" type="i">
      <default>48</default>
      <range min="32" max="64"/>
      <summary>Launcher icon size</summary>
    </key>
    <key name="dash-icon-size" type="i">
      <default>96</default>
      <range min="64" max="128"/>
      <summary>Dash icon size</summary>
    </key>
    <key name="dash-maximized" type="b">
      <default>false</default>
      <summary>Open the dash maximized rather than as a popover</summary>
    </key>
    <key name="show-frequent-apps" type="b">
      <default>true</default>
      <summary>Show the frequent-apps row above the dash's apps grid</summary>
    </key>
  </schema>
</schemalist>
