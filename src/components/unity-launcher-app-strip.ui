<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="UnityLauncherAppStrip" parent="GtkWidget">
    <child>
      <object class="GtkScrolledWindow" id="scroller">
        <property name="child">
          <object class="GtkBox" id="strip">
            <property name="spacing">12</property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
